# =============================================================================
# Fichier     : k8s/secret.yaml.example
# Rôle        : MODÈLE du Secret de la base (identifiants PostgreSQL). Jamais
#               appliqué (kubectl n'applique que .yaml/.yml/.json) : le vrai
#               Secret est créé avec un mot de passe aléatoire :
#   kubectl create secret generic workshop-organizer-db-secret \
#     --from-literal=username=postgres \
#     --from-literal=password="$(head -c 18 /dev/urandom | od -An -tx1 | tr -d ' \n')"
# ⚠️ Ne JAMAIS faire « kubectl apply -f » sur ce fichier : il remplacerait le
#    vrai mot de passe par la valeur d'exemple
# Utilisé par : deployment-db.yaml et deployment-app.yaml (secretKeyRef)
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: workshop-organizer-db-secret
type: Opaque
data:
  username: cG9zdGdyZXM=
  # base64 n'est PAS un chiffrement (simple encodage, réversible) :
  # valeur d'exemple seulement, le vrai mot de passe vit dans le cluster
  password: Q0hBTkdFX01F

# =============================================================================
# Fichier     : .env.example
# Rôle        : modèle des variables attendues par docker-compose.yml
#               → copier en .env (non commité) et remplacer les valeurs
#                 cp .env.example .env
# =============================================================================

# Base PostgreSQL (lues par le service db ET par l'API)
POSTGRES_DB=workshopsdb
POSTGRES_USER=workshops_user
POSTGRES_PASSWORD=a_remplacer_par_un_mot_de_passe_fort
